# Environment example for Dylan Video Studio

# Application
NODE_ENV=development

# Backend
PORT_BACKEND=4000
DATABASE_URL=file:./prisma/dev.db

# Remotion
REMOTION_OUTPUT=./remotion/out

# Frontend
PORT_FRONTEND=5173

# AI providers (do NOT add keys here; use your own .env locally)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
