{
  "name": "dylan-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json --outDir dist",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "lint": "eslint \"src/**/*.{ts,js}\" || true",
    "test": "vitest --run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "pino": "^8.18.0",
    "zod": "^3.22.2",
    "@prisma/client": "7.9.1"
  },
  "devDependencies": {
    "prisma": "7.9.1",
    "ts-node-dev": "2.0.0",
    "@types/express": "4.17.21",
    "@types/node": "20.2.5",
    "vitest": "1.5.5",
    "supertest": "6.3.3",
    "@types/supertest": "2.0.12",
    "eslint": "8.44.0",
    "typescript": "5.2.2"
  }
}
